#!/usr/bin/env ruby
require_relative "../lib/rclojure"
require_relative "../lib/rclojure/repl"

if ARGV.empty?
  RClojure::REPL.new.run
else
  begin
    RClojure::Runtime.new.load_file(ARGV.first)
  rescue StandardError, ScriptError, SystemStackError => e
    warn RClojure::REPL.describe_error(e)
    exit 1
  end
end
